# ---- mode ----
LIVE_TRADING=false            # true = real money. Leave false until paper results justify it.
STRATEGY=momentum             # momentum | volume_breakout
POLL_SECONDS=30
JOURNAL_PATH=journal.jsonl

# ---- live execution (only read when LIVE_TRADING=true) ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # use a paid RPC for live
SOLANA_PRIVATE_KEY=           # base58 key of a BURNER wallet. Never commit this file.
JUPITER_BASE_URL=https://lite-api.jup.ag
SLIPPAGE_BPS=300              # 3%

# ---- sizing & risk (SOL) ----
PAPER_STARTING_SOL=5
TRADE_SIZE_SOL=0.1
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_SOL=0.5        # bot stops opening trades for the day after this
STOP_LOSS_PCT=25
TAKE_PROFIT_PCT=100           # at +100%...
TAKE_PROFIT_SELL_FRACTION=0.5 # ...sell half, let the rest ride with the trailing stop
TRAILING_STOP_PCT=30
MAX_HOLD_MINUTES=240
PAPER_COST_PCT=2              # simulated fees+slippage per side

# ---- token filters ----
MIN_LIQUIDITY_USD=25000
MIN_PAIR_AGE_MINUTES=30
MAX_RUGCHECK_SCORE=1000
REQUIRE_RUGCHECK=true

# ---- Grok / xAI (optional; leave key empty to disable) ----
XAI_API_KEY=
GROK_MODEL=grok-4
GROK_MIN_SCORE=0.0            # reject trades when X sentiment is below this (-1..1)
GROK_CACHE_MINUTES=30
